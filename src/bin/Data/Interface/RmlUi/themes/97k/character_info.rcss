/* The 97k theme's CCharacterInfoWindow: the 0.97k client's RenderCharacterInfoWindow(). The frame
   and the exit are docked_panel_frame.rcss's. The name and the class or server are on the 0.97k
   title bands (0xFF141414 at half strength), 120 wide at 35,12 and 150 wide at 22 under it. The
   level and each attribute are written in a Level_box (75x21) every 60 units from 56 (stamina's
   15 lower, see below), label and
   value together ("Fuerza: 28", character_info.rml's fork joins them), centred in 70 from 14. Each
   derived line is on its own black band (0x80000000) 130 wide at 24, as tall as the text, 15
   apart from 20 under the box. The point button (Level_01, Level_02 pressed) stands at 125, and the
   points to spend are black on the 0.97k blue band at 95,49. Text is counter-scaled from the RML,
   as in legacy, so no rule here sets a font size; it keeps these places whatever its length.
   Coordinates are reference px.

   Sven shows more than the 0.97k client: agility has a third derived line, so the stamina box,
   its button and its line stand one line (15) lower than the 0.97k ones, clear of it. The fruit probability line has no place in the 0.97k
   layout and is hidden; the fruit points take the 0.97k reset-points line. The quest and pet
   shortcuts the 0.97k client didn't have are the Season 3 client's (Quest1 and pet1, 24x24, at 55
   and 85 of the exit's row; Quest2 and pet2 while held). Season 3 had no master skill tree, so its
   shortcut is gone; the build has no tree either (Core/Globals/ClientProfile.h). */
@spritesheet chainfo97-box-sheet        { src: "../../../../Interface97/Level_box.jpg"; chainfo97-box: 0px 0px 75px 21px; }
@spritesheet chainfo97-stat-btn-sheet   { src: "../../../../Interface97/Level_01.jpg"; chainfo97-stat-btn: 0px 0px 24px 24px; }
@spritesheet chainfo97-stat-press-sheet { src: "../../../../Interface97/Level_02.jpg"; chainfo97-stat-press: 0px 0px 24px 24px; }
@spritesheet chainfo97-quest-sheet       { src: "../../../../Interface97/Quest1.jpg"; chainfo97-quest: 0px 0px 24px 24px; }
@spritesheet chainfo97-quest-press-sheet { src: "../../../../Interface97/Quest2.jpg"; chainfo97-quest-press: 0px 0px 24px 24px; }
@spritesheet chainfo97-pet-sheet         { src: "../../../../Interface97/pet1.jpg"; chainfo97-pet: 0px 0px 24px 24px; }
@spritesheet chainfo97-pet-press-sheet   { src: "../../../../Interface97/pet2.jpg"; chainfo97-pet-press: 0px 0px 24px 24px; }

/* The name centred on its band (35,12, 120 wide), the class and the server crossfading on theirs
   under it (22, 150 wide). Each band is as tall as its text. */
#name, #classname, #servername {
	position: absolute;
	top: 12px;
	line-height: 1;
	text-align: center;
	transform-origin: left top;
	font-weight: bold;
	white-space: nowrap;
	background-color: rgba(20, 20, 20, 128);
	pointer-events: none;
}
#name { left: 35px; }
#classname, #servername { left: 22px; top: 23px; color: #ffffff; }

/* Legacy's summary box: the 0.97k client drew the level in a Level_box like the attributes', so
   its fill is that box and the rest goes. */
.summary-fill {
	position: absolute;
	left: 13px;
	top: 56px;
	width: 75px;
	height: 21px;
	decorator: image(chainfo97-box);
	pointer-events: none;
}
.summary-corner, .summary-edge { display: none; }

.level-text, .levelup-point-text, .exp-text, .point-probability-text, .point-text {
	display: block;
	position: absolute;
	transform-origin: left top;
	white-space: nowrap;
	pointer-events: none;
}
/* The level, centred in the first box (14,60 in a 70-wide box). */
.level-text { left: 14px; top: 60px; width: 70px; text-align: center; transform-origin: center top; color: #e6e6e6; }
/* Points to spend: black on the 0.97k blue band (0xFF1E6EC8, ARGB), centred at 95,49 in an
   80-wide box. */
.levelup-point-text {
	left: 95px;
	top: 49px;
	width: 80px;
	text-align: center;
	transform-origin: center top;
	color: #000000;
	background-color: rgb(30, 110, 200);
}
/* Experience and the fruit points under the level, each on its black band 130 wide (24,80 and
   24,95). */
.exp-text { left: 24px; top: 80px; line-height: 1; color: #ffffff; background-color: rgba(0, 0, 0, 128); }
.point-text { left: 24px; top: 95px; line-height: 1; color: rgb(100, 150, 255); background-color: rgba(0, 0, 0, 128); font-weight: bold; }
.point-probability-text { display: none; }

/* The attributes' boxes, every 60 from 116 (the level's is at 56), stamina's 15 lower. */
.attr-textbox {
	position: absolute;
	left: 13px;
	width: 75px;
	height: 21px;
	decorator: image(chainfo97-box);
	pointer-events: none;
}
.attr-textbox-str { top: 116px; }
.attr-textbox-agi { top: 176px; }
.attr-textbox-vit { top: 251px; }
.attr-textbox-ene { top: 296px; }
.attr-textbox-cmd { top: 356px; }

/* The label and value centred in the box (14 to 84), in the cream the 0.97k client shows them in.
   The separate value leaf goes. */
.attr-label, .attr-value {
	display: block;
	position: absolute;
	white-space: nowrap;
	pointer-events: none;
	color: rgb(230, 210, 180);
}
.attr-label { left: 14px; width: 70px; text-align: center; transform-origin: center top; }
.attr-value { display: none; }
.attr-label-str, .attr-value-str { top: 120px; }
.attr-label-agi, .attr-value-agi { top: 180px; }
.attr-label-vit, .attr-value-vit { top: 255px; }
.attr-label-ene, .attr-value-ene { top: 300px; }
.attr-label-cmd, .attr-value-cmd { top: 360px; }

/* The derived lines, 15 apart from 20 under the box, each on its own black band 130 wide and as
   tall as the text, so the art shows between them. */
.attr-lines { position: absolute; left: 24px; transform-origin: left top; pointer-events: none; }
.attr-lines span { display: block; white-space: nowrap; line-height: 1; color: #ffffff; background-color: rgba(0, 0, 0, 128); }
.attr-lines-str { top: 140px; }
.attr-lines-agi { top: 200px; }
.attr-lines-vit { top: 275px; }
.attr-lines-ene { top: 320px; }

.stat-btn {
	position: absolute;
	left: 125px;
	width: 24px;
	height: 24px;
	decorator: image(chainfo97-stat-btn);
	cursor: pointer;
	pointer-events: auto;
}
.stat-btn:active { decorator: image(chainfo97-stat-press); }
.stat-btn-str { top: 115px; }
.stat-btn-agi { top: 175px; }
.stat-btn-vit { top: 250px; }
.stat-btn-ene { top: 295px; }
.stat-btn-cmd { top: 355px; }

/* The Season 3 shortcuts beside the exit, in its row. */
.info-btn {
	position: absolute;
	top: 395px;
	width: 24px;
	height: 24px;
	cursor: pointer;
	pointer-events: auto;
}
.info-btn-quest { left: 55px; decorator: image(chainfo97-quest); }
.info-btn-quest:active { decorator: image(chainfo97-quest-press); }
.info-btn-pet { left: 85px; decorator: image(chainfo97-pet); }
.info-btn-pet:active { decorator: image(chainfo97-pet-press); }
.info-btn-masterlevel { display: none; }

/* data-class-hidden on display:block leaves: base.rcss's .hidden has the same specificity as the
   leaf rules above and loses to them, so it is repeated here with the leaf class. */
.levelup-point-text.hidden, .attr-label.hidden { display: none; }

/* Outlaw level, from the model's pk_level (UI::Chat::SetPlayerColor()'s palette). */
#name.pk-0 { color: rgb(150, 255, 240); }
#name.pk-1 { color: rgb(100, 120, 255); }
#name.pk-2 { color: rgb(140, 180, 255); }
#name.pk-3 { color: rgb(200, 220, 255); }
#name.pk-4 { color: rgb(255, 150, 60); }
#name.pk-5 { color: rgb(255, 80, 30); }
#name.pk-6 { color: rgb(255, 0, 0); }

/* Where an attribute's total comes from (the model's *_value_source), as in legacy. */
.attr-value.attr-boosted, .attr-label.attr-boosted { color: rgb(100, 150, 255); }
.attr-value.attr-potion,  .attr-label.attr-potion  { color: rgb(255, 120, 0); }
.attr-lines span.boosted { color: rgb(100, 150, 255); }
.attr-lines span.buffed { color: rgb(255, 0, 240); }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#name { width: calc(120px * var(--root-scale)); }
#classname, #servername { width: calc(150px * var(--root-scale)); }
.level-text { width: calc(70px * var(--root-scale)); margin-left: calc(35px - 35px * var(--root-scale)); }
.levelup-point-text { width: calc(80px * var(--root-scale)); margin-left: calc(40px - 40px * var(--root-scale)); }
.exp-text, .point-text { width: calc(130px * var(--root-scale)); }
.attr-label { width: calc(70px * var(--root-scale)); margin-left: calc(35px - 35px * var(--root-scale)); }
.attr-lines span { width: calc(130px * var(--root-scale)); height: 1em; margin-bottom: calc(15px * var(--root-scale) - 1em); }
