/* The 97k theme's reconnect dialog, in the art of the 0.97k client's connecting box (its login
   scene's "Connecting" state): Message_box drawn at half brightness (glColor 0.5), the
   Progress_back track (200x16) 7 in from the box's left edge with the Progress fill's band over it
   (below), and the 0.97k Cancel (its top 70x20, Cancel2 under the pointer). The
   0.97k box was 213x64 with one line above it; Sven's dialog has three lines, so the box is 213
   wide centred in the dialog's 230 and as tall as it (122), the lines on it at 12, 30 and 48 in
   white, the track under them at 66 and Cancel under that. Reference px inside #panel. */

@spritesheet rc97-box-sheet { src: "../../../../Interface97/Message_box.jpg"; rc97-box: 0px 0px 213px 64px; }
@spritesheet rc97-track-sheet { src: "../../../../Interface97/Progress_back.jpg"; rc97-track: 0px 0px 200px 16px; }
@spritesheet rc97-cancel-sheet { src: "../../../../Interface97/Cancel.jpg"; rc97-cancel: 0px 0px 70px 20px; }
@spritesheet rc97-cancel-over-sheet { src: "../../../../Interface97/Cancel2.jpg"; rc97-cancel-over: 0px 0px 70px 20px; }

body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; font-family: "token(font-body)"; }
#dim { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #000000; pointer-events: none; }
#panel { position: absolute; transform-origin: left top; width: 230px; height: 122px; pointer-events: none; }
#back { position: absolute; left: 8.5px; top: 0; width: 213px; height: 122px; decorator: image(rc97-box fill); image-color: rgb(128, 128, 128); }
#box_top, #box_middle, #box_bottom { display: none; }
#progress_back { position: absolute; left: 15px; top: 66px; width: 200px; height: 16px; decorator: image(rc97-track); }
/* The 0.97k drew Progress additively over the track, cut at the progress: the art is black but for a
   4-row yellow band (rows 6-9, x 8-191), so only the band showed, saturated over the track to
   about (255, 255, 122). This build has no additive blending, so the band is drawn as that colour,
   183 long at full progress: the bound width counts up to legacy's 150, widened by 183/150. */
#progress_bar {
	position: absolute;
	left: 23px;
	top: 72px;
	height: 4px;
	transform-origin: left top;
	transform: scaleX(1.22);
	background-color: rgb(255, 255, 122);
}
#cancel { position: absolute; left: 80px; top: 92px; width: 70px; height: 20px; decorator: image(rc97-cancel); pointer-events: auto; }
#cancel:hover { decorator: image(rc97-cancel-over); }

.sharp-text { display: block; position: absolute; white-space: nowrap; pointer-events: none; }
.line { color: #ffffff; }

/* The status lines' own rows (PANEL_Y + 12 / 30 / 48) and the panel-wide centring box. */
.line { left: 0; text-align: center; }
#rc_title { top: 12px; font-weight: bold; }
#rc_step { top: 30px; }
#rc_countdown { top: 48px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#rc_title { width: calc(230px * var(--root-scale)); }
#rc_step { width: calc(230px * var(--root-scale)); }
#rc_countdown { width: calc(230px * var(--root-scale)); }
