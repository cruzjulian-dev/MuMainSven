/* The 97k theme's CGuildMakeWindow: the 0.97k client's RenderGuildCreation() on the 0.97k panel
   (docked_panel_frame.rcss). The title is on the 0.97k title band (0xFF141414 at half strength),
   120 wide at 35,12. The editor page is the 0.97k one: the name in an Item_Money box (113x18) at
   55,60, its label 38 left of it and the text 5 into it, both 2 below its top; the 8x8 mark grid of
   15-unit cells from 50,100 with no frame round it, the palette's two rows of 20-unit cells from
   15,260, the selected colour at 16,231 and the two hints at 50,230 and 50,245; and the 0.97k
   buttons, Ok (Ok2 under the pointer) at 20,350 and Cancel (Cancel2 under the pointer) at 100,350, 70x21, whose art
   carries their labels. Sven asks first and shows the finished mark after: those pages keep their
   text on the same panel, the question's button is the 0.97k Message_box button of the event
   windows (its label in the 0.97k red), the exit is the panel's, and the result page has the same
   Ok and Cancel (Next and Back). Reference px inside #panel. */

@spritesheet gm97-big-sheet     { src: "../../../../Interface97/Message_box.jpg"; gm97-big: 0px 0px 213px 64px; }
@spritesheet gm97-ok-sheet      { src: "../../../../Interface97/Ok.jpg";          gm97-ok: 0px 0px 70px 21px; }
@spritesheet gm97-ok-down-sheet { src: "../../../../Interface97/Ok2.jpg";         gm97-ok-down: 0px 0px 70px 21px; }
@spritesheet gm97-cancel-sheet  { src: "../../../../Interface97/Cancel.jpg";      gm97-cancel: 0px 0px 70px 21px; }
@spritesheet gm97-cancel-down-sheet { src: "../../../../Interface97/Cancel2.jpg"; gm97-cancel-down: 0px 0px 70px 21px; }
@spritesheet gm97-name-back-sheet { src: "../../../../Interface97/Item_money.jpg"; gm97-name-back: 0px 0px 113px 18px; }

@spritesheet gm-cell-back-sheet
{
	src: "../../../InventoryBox2.jpg";
	gm-cell-back-13: 0px 0px 13px 14px;
	gm-cell-back-18: 0px 0px 18px 19px;
	gm-cell-back-23: 0px 0px 23px 25px;
}
@spritesheet gm-gold-h-sheet { src: "../../../Trading_line.jpg"; gm-gold-h: 7px 3px 126px 2px; }
@spritesheet gm-gold-v-sheet { src: "../../../Item_Back01.jpg"; gm-gold-v: 1px 80px 2px 125px; }

.frame-top { decorator: image(docked-bg-top-b); }
/* The grid and palette leave the pointer to the window's native hit tests. */
#panel { pointer-events: none; }

.sharp-text { display: block; position: absolute; white-space: nowrap; pointer-events: none; }
.gm-centred { left: 0; text-align: center; }
#title {
	left: 35px;
	top: 12px;
	line-height: 1;
	color: rgb(220, 220, 220);
	font-weight: bold;
	background-color: rgba(20, 20, 20, 128);
}
#info { top: 50px; color: #ffffff; }
#result { top: 140px; color: #ffb049; }
#name_label { left: 17px; top: 62px; color: rgb(230, 230, 230); font-weight: bold; }
.gm-hint { left: 50px; color: #e6e6e6; }

.gm-btn { display: block; position: absolute; pointer-events: auto; }
.gm-btn-big { left: 25px; top: 100px; width: 140px; height: 35px; decorator: image(gm97-big fill); }
.gm-btn-big:active { image-color: rgb(200, 200, 200); }
.gm-btn-big .gm-label { color: rgb(180, 30, 10); font-weight: bold; }
.gm-btn-small { top: 350px; width: 70px; height: 21px; }
#btn_next { left: 20px; decorator: image(gm97-ok); }
#btn_next:hover, #btn_next:active { decorator: image(gm97-ok-down); } /* Ok2 under the pointer */
#btn_back { left: 100px; decorator: image(gm97-cancel); }
#btn_back:hover, #btn_back:active { decorator: image(gm97-cancel-down); } /* Cancel2 under the pointer */
.gm-btn-small .gm-label { display: none; }
.gm-label { left: 0; text-align: center; color: #ffffff; }
#btn_exit { pointer-events: auto; }

#name_back { position: absolute; left: 55px; top: 60px; width: 113px; height: 18px; decorator: image(gm97-name-back); }
#name_field {
	display: none;
	left: 60px;
	top: 62px;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	color: rgb(230, 230, 230);
	pointer-events: auto;
}
#name_field.shown { display: block; }

.gold-rect { position: absolute; pointer-events: none; }
#mark_rect { display: none; }
#result_rect { left: 72px; top: 70px; width: 53px; height: 53px; }
.gold-h { position: absolute; left: 0; top: 0; width: 100%; height: 2px; decorator: image(gm-gold-h); }
.gold-h-end { top: 100%; margin-left: 0; width: 100%; padding-right: 1px; }
.gold-v { position: absolute; left: 0; top: 0; width: 2px; height: 100%; decorator: image(gm-gold-v); }
.gold-v-end { left: 100%; }

.gm-cell { position: absolute; pointer-events: none; }
.gm-cell-13 { width: 15px; height: 15px; decorator: image(gm-cell-back-13); }
.gm-cell-18 { width: 20px; height: 20px; decorator: image(gm-cell-back-18); }
.gm-cell-23 { width: 25px; height: 25px; decorator: image(gm-cell-back-23); }
.gm-fill { position: absolute; left: 1px; top: 1px; }
.gm-cell-13 .gm-fill { width: 13px; height: 13px; }
.gm-cell-18 .gm-fill { width: 18px; height: 18px; }
.gm-cell-23 .gm-fill { width: 23px; height: 23px; }
.gm-cross { position: absolute; height: 2px; background-color: #808080; transform-origin: center; }
.gm-cell-13 .gm-cross { left: -2.69px; top: 5.5px; width: 18.38px; }
.gm-cell-18 .gm-cross { left: -3.73px; top: 8px; width: 25.46px; }
.gm-cell-23 .gm-cross { left: -4.76px; top: 10.5px; width: 32.53px; }
.gm-cross-a { transform: rotate(45deg); }
.gm-cross-b { transform: rotate(-45deg); }

#result_mark { position: absolute; left: 72px; top: 74px; width: 48px; height: 48px; pointer-events: none; }
.mark-cell { float: left; width: 6px; height: 6px; }

/* RenderEditGuildMark()'s own layout: the 8 x 8 mark grid of 15-unit cells from (50, 100), the
   palette's two rows of 20-unit cells from (15, 260), and the selected colour's swatch. */
.gm-grid, .gm-palette { position: static; }
#selected_swatch { left: 15px; top: 230px; }
.gm-hint-1 { top: 230px; }
.gm-hint-2 { top: 245px; }
.gm-grid .gm-cell:nth-child(1) { left: 50px; top: 100px; }
.gm-grid .gm-cell:nth-child(2) { left: 65px; top: 100px; }
