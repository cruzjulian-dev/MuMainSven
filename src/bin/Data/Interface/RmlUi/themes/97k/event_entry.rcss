/* The 97k theme's Devil Square and Blood Castle entries (devil_square_enter, blood_castle_enter):
   the 0.97k event window, measured from the 0.97k client. The panel and the exit are
   docked_panel_frame.rcss's. The title is on the 0.97k title band (0xFF141414 at half strength),
   120 wide at 35,12; the description lines are centred, one line each, 20 apart from 82; each level is a 140x35
   button at 24 with the 0.97k Message_box art stretched over it and its label in the 0.97k red,
   45 apart from 211. Where Sven has more text or levels than the window holds, its pane scrolls
   with the 0.97k chat's scrollbar (Nis_back, Nis_bar, Nis_btnarrow). The panes' places are each
   document's own .rcss. */
#panel { pointer-events: auto; }

#title {
    display: block;
    position: absolute;
    left: 35px;
    top: 12px;
    --flow-w: 120px;
    font-weight: bold;
    line-height: 1;
    background-color: rgba(20, 20, 20, 128);
    text-align: center;
    white-space: normal;
    word-break: break-word;
    pointer-events: none;
}

.entry-lines, .entry-buttons {
    position: absolute;
    left: 6px;
    --flow-w: 178px;
}
.entry-lines {
    line-height: calc(20px * var(--root-scale));
    text-align: center;
}
.entry-line {
    /* One line per row, as the 0.97k client wrote them; a longer one runs out of the pane. */
    display: block;
    white-space: nowrap;
    pointer-events: none;
}


.entry-buttons {
    font-weight: bold;
    line-height: 1.1;
}
.entry-btn {
    /* The label centres on the button. */
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
    width: calc(140px * var(--root-scale));
    min-height: calc(35px * var(--root-scale));
    padding: 0 calc(6px * var(--root-scale));
    pointer-events: auto;
}
.entry-btn + .entry-btn { margin-top: calc(10px * var(--root-scale)); }
.entry-btn-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    pointer-events: none;
}
.entry-label {
    display: block;
    position: relative;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
}

/* The 0.97k chat's scrollbar. The panes are already physical-sized, so their lengths are reference
   px times the panel's scale. */
@spritesheet entry97-rail-sheet  { src: "../../../../Interface97/Nis_back.jpg";     entry97-rail: 0px 0px 13px 1px; }
@spritesheet entry97-thumb-sheet { src: "../../../../Interface97/Nis_bar.jpg";      entry97-thumb: 0px 0px 11px 1px; }
@spritesheet entry97-arrow-sheet { src: "../../../../Interface97/Nis_btnarrow.jpg"; entry97-arrow: 0px 0px 13px 13px; }
.entry-lines scrollbarvertical, .entry-buttons scrollbarvertical {
    width: calc(13px * var(--root-scale));
}
.entry-lines scrollbarvertical slidertrack, .entry-buttons scrollbarvertical slidertrack {
    decorator: image(entry97-rail fill);
}
.entry-lines scrollbarvertical sliderbar, .entry-buttons scrollbarvertical sliderbar {
    height: auto;
    min-height: calc(8px * var(--root-scale));
    margin-left: calc(1px * var(--root-scale));
    margin-right: calc(1px * var(--root-scale));
    decorator: image(entry97-thumb fill);
}
.entry-lines scrollbarvertical sliderarrowdec, .entry-lines scrollbarvertical sliderarrowinc,
.entry-buttons scrollbarvertical sliderarrowdec, .entry-buttons scrollbarvertical sliderarrowinc {
    height: calc(13px * var(--root-scale));
    pointer-events: auto;
    cursor: pointer;
}
.entry-lines scrollbarvertical sliderarrowdec, .entry-buttons scrollbarvertical sliderarrowdec { decorator: image(entry97-arrow); }
.entry-lines scrollbarvertical sliderarrowinc, .entry-buttons scrollbarvertical sliderarrowinc { decorator: image(entry97-arrow flip-vertical); }

#title, .entry-line { color: #ffffff; }
@spritesheet entry97-btn-sheet { src: "../../../../Interface97/Message_box.jpg"; entry97-btn: 0px 0px 213px 64px; }
.entry-btn-art { decorator: image(entry97-btn fill); }
.entry-btn.enabled:active .entry-btn-art { image-color: rgb(200, 200, 200); }
/* The 0.97k red; a level the hero can't enter is the same red, dimmed. */
.entry-label { color: rgb(110, 40, 30); }
.entry-btn.enabled .entry-label { color: rgb(180, 30, 10); }
.entry-exit-glyph { display: none; }
