/* The 97k theme's login/character-scene message box (CMsgWin), in the art of the 0.97k client's
   RenderErrorMessage() default box (UI_StatsPanel.cpp): Message_box, 213x64, centred with its top
   edge at y=60 of the 640x480 canvas; its text white and centred, one line 15 below the top edge,
   two lines at 9 and 21; Ok (70x21) at 71,38 of the box, Ok2 under the pointer. A two-button box
   (the 0.97k yes/no boxes) has Ok at 21 and Cancel at 121, 38 down; the resident-password prompt
   (the 0.97k delete-character box) has its field at 30,38 and Ok and Cancel squeezed to 40x21 at
   110 and 160, as the 0.97k client drew them. A box without buttons (please wait) centres its text
   in the box. Reference dp inside #panel. */

@spritesheet mw97-box-sheet { src: "../../../../Interface97/Message_box.jpg"; mw97-box: 0px 0px 213px 64px; }
@spritesheet mw97-ok-sheet { src: "../../../../Interface97/Ok.jpg"; mw97-ok: 0px 0px 70px 21px; }
@spritesheet mw97-ok-over-sheet { src: "../../../../Interface97/Ok2.jpg"; mw97-ok-over: 0px 0px 70px 21px; }
@spritesheet mw97-cancel-sheet { src: "../../../../Interface97/Cancel.jpg"; mw97-cancel: 0px 0px 70px 21px; }
@spritesheet mw97-cancel-over-sheet { src: "../../../../Interface97/Cancel2.jpg"; mw97-cancel-over: 0px 0px 70px 21px; }

#panel {
	/* Not .center-both's centring: the 0.97k box hangs from y=60, below the dialog canvas offset
	   (RmlDialogCanvas.h). */
	position: absolute;
	top: 60dp;
	left: 50%;
	margin-left: -106.5dp;
	margin-top: var(--canvas-top, 0dp);
	transform: none;
	width: 213dp;
	height: 64dp;
	font-family: "token(font-body)";
	font-size: 1rem;
	decorator: image(mw97-box);
}

.msg-line {
	position: absolute;
	left: 0;
	right: 0;
	line-height: 12dp;
	text-align: center;
	color: #ffffff;
	white-space: nowrap;
	pointer-events: none;
}
/* As generic_confirm_dialog.rcss's 0.97k lines: a 12-unit row from 14 (one line), 8 and 20 (two). */
#msg_line1 { top: 14dp; }
#msg_line1.multi-line { top: 8dp; }
#msg_line2 { top: 20dp; }
.no-buttons #msg_line1 { top: 26dp; }
.no-buttons #msg_line1.multi-line { top: 20dp; }
.no-buttons #msg_line2 { top: 32dp; }

/* The 0.97k delete-character box drew its password as UI_RenderInputField() text at 243,98 -- 30,38
   of the box -- on the text's own black band, no frame: one text row tall and about 62 wide
   (measured from the 0.97k client), left of the squeezed Ok. Its text is the 0.97k input colour
   (0xffd2e6ff). */
#input_frame {
	display: none;
	position: absolute;
	left: 30dp;
	top: 38dp;
	width: 62dp;
	height: 9dp;
	background-color: #000000;
	pointer-events: none;
}
.mode-input #input_frame { display: block; }

.msgwin-input-field {
	position: absolute;
	left: 31dp;
	top: 38dp;
	width: 60dp;
	height: 9dp;
	line-height: 9dp;
	padding: 0;
	color: rgb(255, 230, 210);
	font-size: 1rem;
	background-color: transparent;
	border-width: 0;
	box-shadow: none;
	decorator: none;
}

/* The art carries the label, so the bound text is hidden. */
.btn {
	display: none;
	position: absolute;
	top: 38dp;
	width: 70dp;
	height: 21dp;
	cursor: pointer;
	pointer-events: auto;
	color: transparent;
}

#btn_ok { left: 71dp; decorator: image(mw97-ok fill); }
#btn_ok:hover, #btn_ok:active { decorator: image(mw97-ok-over fill); }
.mode-ok-only #btn_ok, .mode-both #btn_ok, .mode-input #btn_ok { display: block; }
.mode-both #btn_ok { left: 21dp; }
.mode-input #btn_ok { left: 110dp; width: 40dp; }

#btn_cancel { left: 71dp; decorator: image(mw97-cancel fill); }
#btn_cancel:hover, #btn_cancel:active { decorator: image(mw97-cancel-over fill); }
.mode-cancel-only #btn_cancel, .mode-both #btn_cancel, .mode-input #btn_cancel { display: block; }
.mode-both #btn_cancel { left: 121dp; }
.mode-input #btn_cancel { left: 160dp; width: 40dp; }
