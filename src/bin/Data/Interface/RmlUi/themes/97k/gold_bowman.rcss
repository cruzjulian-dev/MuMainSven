/* The 97k theme's Golden Archer windows (CGoldBowmanWindow, CGoldBowmanLena): the 0.97k
   client's RenderGoldenArcherWindow(), on the 0.97k panel (docked_panel_frame.rcss) with its title
   in the 0.97k pale cyan (0xFFF0FF96). The exit is the 0.97k one, 24x24 at 25,395 (Exit_02
   pressed), and Register the 0.97k dialog's Ok (70x21, Ok2 pressed), whose art carries its label.
   Each document's _rows.rcss places its rows as in legacy; the #panel rules here win over its
   button places and sprites. The number field keeps legacy's back. */

@spritesheet gb-btn-wide-up-sheet   { src: "../../../../Interface97/Ok.jpg";      gb-btn-wide-up:   0px 0px 70px 21px; }
@spritesheet gb-btn-wide-down-sheet { src: "../../../../Interface97/Ok2.jpg";     gb-btn-wide-down: 0px 0px 70px 21px; }
@spritesheet gb-exit-up-sheet       { src: "../../../../Interface97/Exit_01.jpg"; gb-exit-up:       0px 0px 24px 24px; }
@spritesheet gb-exit-down-sheet     { src: "../../../../Interface97/Exit_02.jpg"; gb-exit-down:     0px 0px 24px 24px; }

#panel .entry-text:nth-child(1) { color: rgb(150, 255, 240); }
#panel .entry-btn:nth-child(1) { left: 60px; top: 289px; width: 70px; height: 21px; }
#panel .entry-btn:nth-child(1) .entry-label { display: none; }
#panel .entry-btn:nth-child(2) { left: 25px; top: 395px; width: 24px; height: 24px; }

.entry-text .sharp-text { white-space: pre; }


#serial_field {
	text-align: left;
	left: 50px;
	top: 260px;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: rgba(0, 0, 0, 25);
	color: rgba(255, 255, 230, 230);
	pointer-events: auto;
}

/* The lucky number field's back. */
@spritesheet gb-serial-back-sheet { src: "../../../newui_guildmakeeditbox.tga"; gb-serial-back: 0px 0px 108px 23px; }

#serial_back { position: absolute; left: 45px; top: 255px; width: 108px; height: 23px; decorator: image(gb-serial-back); }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#serial_field { width: calc(200px * var(--root-scale)); height: calc(14px * var(--root-scale)); line-height: calc(14px * var(--root-scale)); }
