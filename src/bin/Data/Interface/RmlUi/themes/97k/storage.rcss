/* The 97k theme's CStorageInventory: the 0.97k client's RenderWarehouse(). The panel is
   Item_Back01 over Item_Back02, the 8x15 grid of 0.97k cells from 15,50 (item_grid.rcss), the
   stored zen 10 into an Item_Money box at 50,353 with "Zen" 30 left of it on its band, and the
   withdrawal fee at 50,374 (its amount 70 further on), as the 0.97k client drew them. The 0.97k
   buttons are on the 390 row: Money_01 to put zen in at 26 and to take it out at 76, the lock at
   126 (Lock_01 open, Lock_03 locked, the next one pressed). The 0.97k storage has no exit of its own:
   the inventory's closes both (its corner close goes too). Sven's expansion takes the gap at
   101. The workspace places #panel, so coordinates are reference px. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* The 0.97k panel draws no close mark in its corner, so the corner's hit box goes. */
#frame_corner_close { display: none; }

#title {
	position: absolute;
	left: 0;
	top: 12px;
	width: calc(100% * var(--root-scale));
	text-align: center;
	color: rgb(220, 220, 220);
	font-weight: bold;
	font-size: 1em;
}
/* RenderWarehouse() turned the title yellow while the storage was locked. */
#title.locked { color: rgb(255, 255, 0); }

@spritesheet stor97-money-sheet { src: "../../../../Interface97/Item_money.jpg"; stor97-money: 0px 0px 113px 18px; }
#money_bg {
	position: absolute;
	left: 50px;
	top: 353px;
	width: 113px;
	height: 18px;
	decorator: image(stor97-money);
	pointer-events: none;
}
/* "Zen" and the amount 3 below the box's top: the word 30 left of the box on a half-black band
   (0x80000000, darker than the 0.97k 0xFF282828 one) the size of the word, the amount 10 into the box. */
#zen_label {
	position: absolute;
	left: 20px;
	top: 356px;
	color: rgb(255, 220, 150);
	background-color: rgba(0, 0, 0, 128);
	font-weight: bold;
	font-size: 1em;
	white-space: nowrap;
	pointer-events: none;
}
#zen_text {
	position: absolute;
	left: 60px;
	top: 356px;
	font-weight: bold;
	font-size: 1em;
	white-space: nowrap;
	pointer-events: none;
}
/* Both amounts stand from their left edge, so they scale back around it (the markup's sharp-right
   anchors them by the right). */
#zen_text, #fee_value { transform-origin: left top; }
/* The 0.97k warehouse's zen tiers: pale under 100,000, green under a million, then orange, red. */
.gold-amount.gold-base             { color: rgb(255, 220, 150); }
.gold-amount.gold-hundred-thousand { color: rgb(0, 201, 24); }
.gold-amount.gold-million          { color: rgb(255, 150, 0); }
.gold-amount.gold-ten-million      { color: rgb(255, 0, 0); }
/* The fee label at 50,374 in red on the text band, its amount 70 further on in the pale zen. */
#fee_label {
	position: absolute;
	left: 50px;
	top: 374px;
	color: rgb(255, 0, 0);
	background-color: rgba(0, 0, 0, 128);
	font-weight: bold;
	font-size: 1em;
	white-space: nowrap;
	pointer-events: none;
}
#fee_value {
	position: absolute;
	left: 120px;
	top: 374px;
	color: rgb(255, 220, 150);
	font-weight: bold;
	font-size: 1em;
	white-space: nowrap;
	pointer-events: none;
}

@spritesheet stor97-money-btn-sheet     { src: "../../../../Interface97/Money_01.jpg"; stor97-money-btn:     0px 0px 24px 24px; }
@spritesheet stor97-money-press-sheet   { src: "../../../../Interface97/Money_02.jpg"; stor97-money-press:   0px 0px 24px 24px; }
@spritesheet stor97-lock-open-sheet     { src: "../../../../Interface97/Lock_01.jpg";  stor97-lock-open:     0px 0px 24px 24px; }
@spritesheet stor97-lock-open-press-sheet { src: "../../../../Interface97/Lock_02.jpg"; stor97-lock-open-press: 0px 0px 24px 24px; }
@spritesheet stor97-lock-shut-sheet     { src: "../../../../Interface97/Lock_03.jpg";  stor97-lock-shut:     0px 0px 24px 24px; }
@spritesheet stor97-lock-shut-press-sheet { src: "../../../../Interface97/Lock_04.jpg"; stor97-lock-shut-press: 0px 0px 24px 24px; }
@spritesheet stor-btn-expand-sheet      { src: "../../../newui_expansion_btn.tga";     stor-btn-expand:      0px 0px 36px 29px; }
.stor-btn {
	position: absolute;
	top: 390px;
	width: 24px;
	height: 24px;
	cursor: pointer;
	pointer-events: auto;
}
.stor-btn.hidden { display: none; }
.stor-btn-insert, .stor-btn-take { decorator: image(stor97-money-btn); }
.stor-btn-insert:active, .stor-btn-take:active { decorator: image(stor97-money-press); }
.stor-btn-insert { left: 26px; }
.stor-btn-take   { left: 76px; }
.stor-btn-lock   { left: 126px; decorator: image(stor97-lock-open); }
.stor-btn-lock:active { decorator: image(stor97-lock-open-press); }
.stor-btn-lock.locked-mode { decorator: image(stor97-lock-shut); }
.stor-btn-lock.locked-mode:active { decorator: image(stor97-lock-shut-press); }
/* Sven's own, which the 0.97k client didn't have, at the row's height. */
.stor-btn-expand { left: 101px; decorator: image(stor-btn-expand fill); }
.stor-btn-expand:hover { filter: brightness(1.25); }

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 15px; top: 50px; width: calc(8 * var(--item-cell)); height: calc(15 * var(--item-cell)); }

/* The frame: the 0.97k panel. */
@spritesheet stor97-back-top-sheet    { src: "../../../../Interface97/Item_back01.jpg"; stor97-back-top:    0px 0px 190px 256px; }
@spritesheet stor97-back-bottom-sheet { src: "../../../../Interface97/Item_Back02.jpg"; stor97-back-bottom: 0px 0px 190px 177px; }

.bg-fill, .bg-top, .bg-left, .bg-right, .bg-bottom {
	position: absolute;
	pointer-events: none;
}
.bg-fill   { left: 0; top: 0;     width: 190px; height: 256px; decorator: image(stor97-back-top); }
.bg-bottom { left: 0; top: 256px; width: 190px; height: 177px; decorator: image(stor97-back-bottom); }
.bg-top, .bg-left, .bg-right { display: none; }

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }
#panel { font-size: calc(var(--text-px, 12px) / var(--root-scale)); }
