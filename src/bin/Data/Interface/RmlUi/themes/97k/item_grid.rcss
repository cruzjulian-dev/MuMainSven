/* The 97k theme's item grids (CInventoryCtrl), as the 0.97k client's RenderItemsBoxes() drew them:
   an empty cell is Item_box squeezed to the 20-unit pitch, a cell under an item is InventoryBox2
   (its top-left 20x21). The 0.97k grid has no frame. The 0.97k client tinted an item's cells by the
   item's colour, nearly always white; Sven's wear and untradeable tints show through the dimmed
   art instead. CInventoryCtrl::FollowGrid() reads --item-cell back for the hit tests. A window
   places and sizes each grid by its id: width and height are its columns and rows times it. */

@spritesheet item-cell-sheet      { src: "../../../../Interface97/Item_box.jpg";      item-cell-art:  0px 0px 32px 32px; }
@spritesheet item-cell-used-sheet { src: "../../../../Interface97/Inventorybox2.jpg"; item-cell-used: 0px 0px 20px 21px; }

body { --item-cell: 20px; }

.item-grid, .item-grid-counts { position: absolute; pointer-events: none; }
.item-grid-cells, .item-grid-counts { display: flex; flex-wrap: wrap; }
.item-grid-cells { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

.item-cell, .item-count { position: relative; flex: 0 0 var(--item-cell); width: var(--item-cell); height: var(--item-cell); }
.item-cell-art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; decorator: image(item-cell-art); }
.item-cell.tint-normal .item-cell-art,
.item-cell.tint-durability-50 .item-cell-art,
.item-cell.tint-durability-70 .item-cell-art,
.item-cell.tint-durability-80 .item-cell-art,
.item-cell.tint-durability-100 .item-cell-art,
.item-cell.tint-untradeable .item-cell-art { decorator: image(item-cell-used); }
.item-cell.tint-durability-50 .item-cell-art,
.item-cell.tint-durability-70 .item-cell-art,
.item-cell.tint-durability-80 .item-cell-art,
.item-cell.tint-durability-100 .item-cell-art,
.item-cell.tint-untradeable .item-cell-art { opacity: 0.6; }
.item-cell.tint-durability-50 { background-color: rgb(255, 255, 0); }
.item-cell.tint-durability-70 { background-color: rgb(255, 168, 0); }
.item-cell.tint-durability-80 { background-color: rgb(255, 84, 0); }
.item-cell.tint-durability-100 { background-color: rgb(255, 0, 0); }
.item-cell.tint-untradeable { background-color: rgb(255, 51, 26); }
.item-cell-drop { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.item-cell.drop-free .item-cell-drop { background-color: rgba(26, 102, 204, 102); }
.item-cell.drop-blocked .item-cell-drop, .item-cell.drop-invalid .item-cell-drop { background-color: rgba(255, 51, 51, 102); }
.item-cell.drop-valid .item-cell-drop { background-color: rgba(51, 102, 51, 102); }

.item-grid-frame { display: none; }

/* A stack count in 0.9 Font97 digits (token font97-strip; main_frame.rcss has the sizes), tinted
   (1, 0.9, 0.7), centred 7 in from its item's right edge and 2 below its top, as the old-school
   client drew it. The digits are art in the panel's units, so the layer keeps the panel's scale
   instead of counter-scaling like text; the text itself is not painted. */
.item-count-text {
	position: absolute;
	right: 0;
	top: 2px;
	width: 14px;
	text-align: center;
	white-space: nowrap;
	font-weight: bold;
	color: transparent;
	decorator: digit-strip(token(font97-strip) 9.6px);
	image-color: #ffe6b3;
}
.item-count-text.counter-scaled { transform: none; }

/* The window's live items: the panel and a margin round it, for a model reaching past its slot. */
.item-view { position: absolute; left: -20px; top: -20px; width: 230px; height: 469px; pointer-events: none; }
