/* The 97k theme's option (settings) window: legacy's layout (a theme's file replaces its base's
   whole, so the rows are restated here) as a plain 0.97k message box. A near-opaque black panel
   inside a double gold line (the Esc menu buttons' Message_box edge), the window shell's
   message-box sprites hidden; text-only tabs, the open one yellow and underlined; dropdowns as
   black boxes in a dark gold line, the chosen entry under 50% white in black; and the 0.97k Ok (70x21, Ok2 under the pointer) centred at the bottom as the
   close, the art the message boxes use (msg_win.rcss). Settings apply as they change, so Ok only
   closes the window.

   Lives here (themes/97k/), NOT at the RmlUi/ root -- option_window.rml's own
   <link href="option_window.rcss"/> resolves against LoadThemedDocument()'s sourceUrl
   (RmlTheme.cpp), which is always "Data/Interface/RmlUi/themes/<theme>/<name>.rml" regardless of
   which path the RML's own bytes were actually read from.

   The panel is wider than the shell's 230dp msgbox art: five tabs, a label column that can hold a
   translated setting name, and a control column wide enough for a resolution or a language. Its
   height is one fixed size for every tab, so switching tabs never moves the window; it fits the
   tallest tab (Video) with room for labels that wrap to a second line, and is capped to the
   screen, where the settings area scrolls instead (.option-tab-scroll). */
#panel {
	width: 440dp;
	height: 310dp;
	max-height: 96%;
	font-family: "token(font-body)";
	font-size: 1rem;
	color: token(text-input);
}

/* The box: .window-shell-sprite-back is the near-opaque black fill inside the outer gold line
   (205, 171, 133), .window-shell-sprite-middle the inner one (160, 137, 99) 3 units in, both
   sampled from Message_box.jpg's edge. The 97k shell hides the back and draws
   Message_box2/Message_box1 on the others; both are restated here. */
.window-shell-sprite-back {
	display: block;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: rgba(8, 7, 6, 235);
	border: 1dp rgb(205, 171, 133);
	decorator: none;
}
.window-shell-sprite-middle {
	left: 3dp;
	right: 3dp;
	top: 3dp;
	bottom: 3dp;
	border: 1dp rgb(160, 137, 99);
	decorator: none;
}
.window-shell-sprite-top,
.window-shell-sprite-bottom { display: none; }

/* The content well: the tab row at its top, the settings area below it (.option-tab-scroll) and
   the Ok at its foot. An ID selector, so it wins over window_shell.rcss's own
   .window-shell-content insets regardless of link order. */
#content {
	left: 14dp;
	right: 14dp;
	top: 10dp;
	bottom: 10dp;
	display: block;
}

/* One row of text tabs over a dark gold rule: the open one in the 0.97k yellow with a 2-unit underline
   over the rule, the others muted. Sized by their labels (not equal cells): "Gameplay" and
   "Graphics" need more room than "UI". */
.option-tab-row {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	display: flex;
	height: 20dp;
	border-bottom: 1dp rgb(112, 96, 71);
}
.option-tab-btn {
	flex: 0 1 auto;
	margin-right: 14dp;
	padding: 0 2dp;
	height: 20dp;
	line-height: 18dp;
	text-align: center;
	font-size: 1rem;
	white-space: nowrap;
	overflow: hidden;
	cursor: pointer;
	pointer-events: auto;
	color: rgb(138, 130, 120);
}
.option-tab-btn:hover {
	color: rgb(230, 220, 200);
}
.option-tab-btn.active-tab {
	color: rgb(255, 210, 74);
	border-bottom: 2dp rgb(255, 210, 74);
}

/* The settings of the active tab, between the tab row and the Ok. It scrolls with the chat log's
   scrollbar (base.rcss's .scroll-pane) when its rows don't fit; the tabs and the Ok stay where they
   are. A tab's last dropdown opens its list upwards (.option-opens-up), so it stays inside this
   area. */
.option-tab-scroll {
	position: absolute;
	left: 0;
	right: 0;
	top: 28dp;
	bottom: 30dp;
}

/* One tab's rows, top to bottom. The .hidden override is needed because this display:flex would
   otherwise tie with base.rcss's .hidden{display:none} and win by load order. */
.option-tab-panel {
	display: flex;
	flex-direction: column;
	padding: 2dp 10dp 0 4dp;
}
.option-tab-panel.hidden {
	display: none;
}

/* A label column and a control column. A row is as tall as its label, which wraps when a
   translation or a larger font needs a second line, and at least as tall as its control. */
.option-row {
	position: relative;
	display: flex;
	align-items: center;
	flex-shrink: 0;
	min-height: 20dp;
	margin-bottom: 6dp;
}
/* A part of the row above it: indented under its label, its control still in the column. */
.option-sub-row .option-row-label {
	margin-right: -12dp;
	padding-left: 12dp;
}

/* A heading over a group of rows. */
.option-section {
	flex-shrink: 0;
	margin: 6dp 0 6dp;
	padding-bottom: 2dp;
	border-bottom: 1dp rgb(112, 96, 71);
	color: rgb(255, 210, 74);
}
.option-section:first-child {
	margin-top: 0;
}
.option-checkbox-row {
	cursor: pointer;
	pointer-events: auto;
}
/* Not base.rcss's own .checkbox-label -- that's position:absolute, glyph-first (built for
   login.rml's standalone checkboxes), which doesn't line up with a column of sibling rows. This
   row uses .option-row-label (below) instead, label-first in the markup, same as every other row
   type -- see option_window.rml's own comment. */
.checkbox-box {
	flex-shrink: 0;
}
/* Tick is baked into the checked-state sprite art (base.rcss's .checkbox-box.checked), same as
   login.rcss's own legacy checkbox -- .checkbox-tick draws nothing here. */
.checkbox-tick {
	display: none;
}

/* The label column: 44% of the row, the controls start where it ends in every row. */
.option-row-label {
	width: 44%;
	flex-shrink: 0;
	padding-right: 8dp;
	white-space: normal;
	line-height: 1.3em;
	color: rgb(230, 220, 200);
}

/* Volume and effect-limit gauges: base.rcss's .level-gauge at native's sizes (the volume bars
   124x16, the effect bar drawn 70x15), beside their labels. Native's volume hit area began 8
   units before the bar. */
.option-gauge {
	position: relative;
	flex-shrink: 0;
	width: 124dp;
	height: 14dp;
}
.option-gauge.effect-gauge {
	width: 70dp;
	height: 15dp;
}
.option-gauge .level-gauge-fill {
	left: 0;
	top: 0;
	bottom: 0;
}
.option-gauge-hit {
	left: -8dp;
	right: 0;
}

/* Custom dropdown -- NOT RmlUi's native <select>/<option> (WidgetDropDown). That was tried first
   and never reliably worked in this engine: the widget's own generated
   selectvalue/selectbox/selectarrow sub-elements need CSS this
   theme never fully gave them (no `position` set programmatically the way WidgetSlider forces
   `drag` on its own sub-elements), and even once styled, option clicks still didn't reliably reach
   this window's own change callback. This reuses the exact data-for/data-class/data-event-click
   mechanism .option-tab-btn above already proves reliable, plus a single shared
   model.openDropdown field (OptionWindow.h) so opening one dropdown closes any other automatically
   -- no separate exclusivity logic needed. position:relative so .option-dropdown-list's own
   position:absolute (below) resolves against ITS box. */
.option-dropdown {
	position: relative;
	flex: 1 1 auto;
	max-width: 200dp;
	height: 18dp;
}
/* border-box: width 100% plus the padding and border ran past the frame's right edge. */
.option-dropdown-value {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 100%;
	padding: 0 4dp;
	line-height: 18dp;
	white-space: nowrap;
	overflow: hidden;
	cursor: pointer;
	pointer-events: auto;
	background-color: #000000;
	border-width: 1dp;
	border-color: rgb(112, 96, 71);
	color: rgb(230, 220, 200);
}
.option-dropdown-value:hover {
	border-color: rgb(205, 171, 133);
}
/* Floating popup -- top:100% (not a hardcoded dp offset) so it always sits flush under the value
   box regardless of that row's own height. max-height+overflow-y:auto caps a long list
   (Resolution has ~25 entries) with a real scrollbar instead of growing past the panel. Needs the
   .hidden override below: this file loads after base.rcss, so its own display:block would
   otherwise tie with (and silently beat) base.rcss's global .hidden{display:none} at equal
   specificity -- same cascade-tie bug .option-tab-panel's own comment already covers.

   z-index:1 -- without it, this absolutely-positioned popup paints/hit-tests at its own plain DOM
   position among .option-row siblings, i.e. BEHIND whichever row comes later in markup order (an
   .option-row without its own z-index just participates in normal top-to-bottom paint order, same
   as any other sibling): a dropdown opened above a lower row would render behind it, and clicking
   an option that visually overlaps a checkbox row would trigger that checkbox instead.
   RmlUi's own native <select> (WidgetDropDown.cpp) sets this same 1 on its generated
   selectbox for the identical reason -- this is the custom-dropdown equivalent of that. */
.option-dropdown-list {
	display: block;
	position: absolute;
	left: 0;
	top: 100%;
	box-sizing: border-box;
	width: 100%;
	max-height: 90dp;
	overflow-y: auto;
	z-index: 1;
	background-color: rgba(0, 0, 0, 245);
	border-width: 1dp;
	border-color: rgb(112, 96, 71);
	pointer-events: auto;
}
.option-dropdown-list.hidden {
	display: none;
}
/* Explicit scrollbar sizing, same reasoning generic_confirm_dialog.rcss's own .gcd-text-col
   comment already gives for its own overflow:auto well -- an unstyled scrollbarvertical isn't
   just visually wrong, its own (also unstyled) hit-test area can cover most/all of the option
   row's width instead of a slim strip at the edge, silently swallowing clicks meant for the
   option text beneath it as a scrollbar drag instead. Arrow buttons collapsed to 0, same
   drag/click-only affordance as every other scrollbar in this codebase. */
.option-dropdown-list scrollbarvertical {
	width: 6dp;
	margin: 0;
}
.option-dropdown-list scrollbarvertical slidertrack {
	background-color: rgb(30, 28, 26);
}
.option-dropdown-list scrollbarvertical sliderbar {
	background-color: rgb(106, 97, 88);
}
.option-dropdown-list scrollbarvertical sliderbar:hover,
.option-dropdown-list scrollbarvertical sliderbar:active {
	background-color: rgb(146, 144, 141);
}
.option-dropdown-list scrollbarvertical sliderarrowdec,
.option-dropdown-list scrollbarvertical sliderarrowinc {
	width: 0;
	height: 0;
}
.option-dropdown-option {
	display: block;
	width: 100%;
	padding: 2dp 4dp;
	white-space: nowrap;
	cursor: pointer;
	pointer-events: auto;
	color: rgb(230, 220, 200);
}
.option-dropdown-option:hover {
	color: #ffffff;
	background-color: rgb(60, 55, 50);
}
/* The guild lists' selected row: 50% white, the text in black. */
.option-dropdown-option.selected {
	color: #000000;
	background-color: rgba(255, 255, 255, 128);
}

/* A row with a hint (data-hint) takes the pointer itself, so the hint shows anywhere on the row:
   body's pointer-events: none would leave only its control hoverable. */
.option-row-tipped {
	pointer-events: auto;
}
/* A tab's last dropdown opens its list upwards, over the rows above. */
.option-opens-up .option-dropdown-list {
	top: auto;
	bottom: 100%;
}

/* The close is the 0.97k Ok, 70x21 at its own size, centred at the foot of #content, Ok2 under the
   pointer as the 0.97k boxes (msg_win.rcss). The art is lettered, so the element needs no label. */
@spritesheet opt97-ok-sheet      { src: "../../../../Interface97/Ok.jpg";  opt97-ok:      0px 0px 70px 21px; }
@spritesheet opt97-ok-over-sheet { src: "../../../../Interface97/Ok2.jpg"; opt97-ok-over: 0px 0px 70px 21px; }
.option-close-btn {
	position: absolute;
	left: 50%;
	bottom: 0;
	margin-left: -35dp;
	width: 70dp;
	height: 21dp;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(opt97-ok);
}
.option-close-btn:hover,
.option-close-btn:active {
	decorator: image(opt97-ok-over);
}

/* The original's options window has no title banner, only the plain top cap: the shell's title
   (bound to "Option" for the modern theme) is not shown here. It used to be invisible by accident
   (its font was an unsubstituted token in window_shell.rcss). */
.window-shell-header-rail,
.window-shell-header-title { display: none; }

/* A setting another one already covers (OptionWindow.h's OptionRmlModel): shown ticked, dimmed, and
   not clickable. */
.option-checkbox-row.locked {
	opacity: 0.45;
	cursor: default;
}

/* The player's tuning of each Enhanced feature (OptionWindow.h's tuning rows), under the feature's
   row. The feature's label and chevron expand its sliders; only the checkbox switches the feature.
   A locked feature dims its checkbox, not its label, which still expands the tuning. */
.option-tuning-group-row {
	cursor: default;
}
.option-tuning-group-row.locked {
	opacity: 1;
}
.option-tuning-group-row.locked .checkbox-box {
	opacity: 0.45;
}
.option-tuning-group-row .checkbox-box {
	cursor: pointer;
}
.option-tuning-group-label {
	cursor: pointer;
}
.option-tuning-group-label:hover {
	color: token(text-primary);
}
/* A small arrow before the label: pointing right while collapsed, down while expanded. */
.option-tuning-chevron {
	display: inline-block;
	width: 5dp;
	height: 5dp;
	margin: 0 6dp 1dp -10dp;
	border-right: 1dp token(text-secondary);
	border-bottom: 1dp token(text-secondary);
	transform: rotate(-45deg);
}
.option-tuning-chevron.expanded {
	transform: rotate(45deg);
}
/* .hidden ties with these rules' display at equal specificity, so it is restated. */
.option-tuning-group,
.option-tuning-more,
.option-tuning-rows {
	display: block;
	flex-shrink: 0;
}
.option-tuning-group {
	margin: -2dp 0 8dp 12dp;
	padding-left: 6dp;
	border-left: 1dp #5a4a2a;
}
.option-tuning-group.hidden,
.option-tuning-more.hidden,
.option-tuning-reason.hidden,
.option-tuning-error.hidden {
	display: none;
}
.option-tuning-reason {
	display: block;
	margin-bottom: 4dp;
	color: token(semantic-warning);
}
.option-tuning-row {
	display: block;
	margin-bottom: 6dp;
}
.option-tuning-head {
	display: flex;
	align-items: center;
}
.option-tuning-label {
	flex: 1 1 auto;
	color: token(text-input);
}
.option-tuning-value {
	flex: 0 0 auto;
	margin-left: 6dp;
	color: token(text-primary);
}
.option-tuning-state {
	flex: 0 0 auto;
	margin-left: 6dp;
	color: token(text-muted);
}
.option-tuning-state.custom {
	color: token(accent-gold);
}
.option-tuning-state.unsaved {
	color: token(semantic-warning);
}
.option-tuning-reset {
	flex: 0 0 auto;
	margin-left: 6dp;
	padding: 0 4dp;
	cursor: pointer;
	pointer-events: auto;
	color: token(text-muted);
	border-width: 1dp;
	border-color: token(border-control);
	background-color: token(surface-control);
}
.option-tuning-reset:hover {
	color: token(text-primary);
}
.option-tuning-track {
	display: flex;
	align-items: center;
	margin-top: 2dp;
}
.option-tuning-bound {
	flex: 0 0 auto;
	width: 52dp;
	white-space: nowrap;
	color: token(text-muted);
}
.option-tuning-track .option-tuning-bound:last-child {
	text-align: right;
}
/* The volume gauge's art: its rail, and its full fill at its own size, cut off at the value as
   native draws it (scale-none crops the image to the fill's width). */
.option-tuning-slider {
	margin: 0 6dp;
}
.option-tuning-fill {
	decorator: image(level-gauge-fill-10 scale-none left center);
}
.option-tuning-hit {
	left: -6dp;
	right: -6dp;
	top: -5dp;
	bottom: -5dp;
}
.option-tuning-hit:focus {
	border-width: 1dp;
	border-color: token(accent-gold);
}
.option-tuning-group.locked .option-tuning-track {
	opacity: 0.45;
}
.option-tuning-group.locked .option-tuning-hit {
	cursor: default;
}
.option-tuning-more-head {
	display: block;
	margin: 2dp 0 6dp;
	cursor: pointer;
	pointer-events: auto;
	color: token(text-secondary);
}
.option-tuning-more-head .option-tuning-chevron {
	margin-left: 0;
}
.option-tuning-more-head:hover {
	color: token(text-primary);
}
.option-tuning-actions {
	display: flex;
	flex-shrink: 0;
	justify-content: flex-end;
	margin-bottom: 4dp;
}
.option-tuning-all {
	margin: 0 0 8dp;
}
.option-tuning-error {
	display: block;
	flex-shrink: 0;
	margin-bottom: 8dp;
	color: token(semantic-danger);
}

/* The font rows' first button starts on the control column, where the checkboxes do. */
.option-sub-row .option-row-label + .option-tuning-reset {
	margin-left: 0;
}
/* The text size between its - and + buttons. */
.option-font-height {
	width: 24dp;
	text-align: center;
	color: token(text-input);
}
