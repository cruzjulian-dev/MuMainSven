/* The personal-shop notice (my_shop, purchase_shop) as the Season 3 client wrote it: in bold, 15
   between lines, 10 more before the last group, the warnings pulsing. That client's short lines started at 30,230; the longer translated ones wrap, so the pane starts at
   18,205 and is wider, and only scrolls if they still don't fit. Colours stay in each window's
   stylesheet. */

.shop-notice {
	position: absolute;
	left: 18px;
	top: 205px;
	--flow-w: 156px;
	height: calc(185px * var(--root-scale));
	/* Room for a glyph's overhang, such as a J's hook, inside the clip. */
	padding: 0 calc(2px * var(--root-scale));
	line-height: calc(15px * var(--root-scale));
	font-weight: bold;
}
.notice-line {
	display: block;
	white-space: normal;
	word-break: break-word;
	pointer-events: none;
}
.notice-group { display: block; }
.notice-group + .notice-group + .notice-group { margin-top: calc(10px * var(--root-scale)); }

/* That client's alpha, min(255, sin(time * 0.005) * 200 + 275): opaque for just over half of its
   1.26s cycle, then down to 75 and back. */
@keyframes shop97-warning-pulse {
	0% { opacity: 1; }
	53% { opacity: 1; }
	76.5% { opacity: 0.29; }
	100% { opacity: 1; }
}
.notice-warning { animation: 1.26s sine-in-out infinite shop97-warning-pulse; }

/* The pane is already physical-sized. Its scrollbar must not counter-scale again. */
.shop-notice scrollbarvertical { width: calc(15px * var(--root-scale)); }
.shop-notice scrollbarvertical sliderbar { height: calc(30px * var(--root-scale)); }
